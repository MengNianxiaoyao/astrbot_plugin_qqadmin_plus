{
  "default": {
    "description": "默认群配置",
    "hint": "这些配置项会作为默认群模板使用。具体群开启“跟随默认配置”后，会直接继承这里的设置；关闭后则保存自己的独立配置。",
    "obvious_hint": true,
    "type": "object",
    "items": {
      "join_switch": {
        "description": "总开关",
        "hint": "开启后，进群退群模块的功能才会在当前群聊生效，群主、群管理可用命令 “进群审核 开/关” 为当前群聊设置",
        "type": "bool",
        "default": true
      },
      "join_min_level": {
        "description": "等级门槛",
        "hint": "当申请人的QQ等级低于此值时，自动拒绝进群申请。设为0表示不启用此功能。可通过群内命令为当前群聊设置",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "default": 8
      },
      "join_max_time": {
        "description": "最大尝试次数",
        "hint": "当用户申请进行的次数超过此值时，自动拒绝进群申请。可通过群内命令为当前群聊设置",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 10,
          "step": 1
        },
        "default": 3
      },
      "join_accept_words": {
        "description": "白词",
        "hint": "用户申请加群时, 若进群答案中包含这些关键词，则自动通过申请",
        "type": "list",
        "default": [
          "白词1",
          "白词2"
        ]
      },
      "join_reject_words": {
        "description": "黑词",
        "hint": "用户申请加群时, 若进群答案中包含这些关键词，则自动拒绝申请",
        "type": "list",
        "default": [
          "黑词1",
          "黑词2"
        ]
      },
      "join_no_match_msg": {
        "description": "验证为空拒绝",
        "hint": "当用户申请加群时，验证消息为空时自动拒绝",
        "type": "bool",
        "default": false
      },
      "join_no_match_reject": {
        "description": "未命中白词拒绝",
        "hint": "当用户申请加群时，没命中进群关键词，则自动驳回申请",
        "type": "bool",
        "default": false
      },
      "join_full_reject": {
        "description": "群满自动拒绝",
        "hint": "群人数已满时自动拒绝进群申请",
        "type": "bool",
        "default": true
      },
      "join_full_msg": {
        "description": "群满拒绝文案",
        "hint": "群人数已满自动拒绝进群申请时，向申请人展示的拒绝理由",
        "type": "string",
        "default": "群人数已满"
      },
      "join_single_group": {
        "description": "禁止多群加入",
        "hint": "开启后，已加入或正在申请同账号管理的其他群聊的QQ号，进群时自动拒绝",
        "type": "bool",
        "default": false
      },
      "join_silent_reasons": {
        "description": "免通知类型",
        "hint": "勾选后，自动批准/驳回结果命中时不发送通知",
        "type": "list",
        "options": [
          "full",
          "allow",
          "white_word",
          "block",
          "multi_group",
          "empty_msg",
          "level_low",
          "black_word",
          "black_word_block",
          "max_fail",
          "no_match"
        ],
        "labels": [
          "群满拒绝",
          "白名单通过",
          "命中白词通过",
          "黑名单",
          "多群加入",
          "验证为空",
          "等级过低",
          "命中黑词",
          "命中黑词已拉黑",
          "超次已拉黑",
          "未命中驳回"
        ],
        "default": [
          "full",
          "allow",
          "white_word",
          "block",
          "empty_msg"
        ]
      },
      "reject_word_block": {
        "description": "命中黑词拉黑",
        "hint": "当用户因触发进群黑词而被拒绝进群时，自动拉黑该用户",
        "type": "bool",
        "default": false
      },
      "allow_ids": {
        "description": "白名单",
        "hint": "用户加入群聊时，若用户QQ在白名单中，则自动通过，退群时也不会被自动拉黑",
        "type": "list",
        "default": []
      },
      "block_ids": {
        "description": "黑名单",
        "hint": "用户加入群聊时，若用户QQ在黑名单中，则自动拒绝",
        "type": "list",
        "default": []
      },
      "use_global_allow": {
        "description": "全局白名单",
        "hint": "开启后，使用全局白名单（JSON文件）替代进群白名单",
        "type": "bool",
        "default": false
      },
      "use_global_block": {
        "description": "全局黑名单",
        "hint": "开启后，使用全局黑名单（JSON文件）替代进群黑名单，自动拉黑操作也将写入全局黑名单",
        "type": "bool",
        "default": false
      },
      "join_welcome": {
        "description": "欢迎词",
        "hint": "发给新群友的欢迎词, 支持@和图片CQ码, 支持变量: {nickname}、{qq}, 示例：[CQ:at,qq={qq}] 欢迎{nickname}加入群聊",
        "type": "string",
        "default": ""
      },
      "join_ban_time": {
        "description": "进群禁言",
        "hint": "单位为秒，新成员进群时，自动禁言该成员",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 300,
          "step": 10
        },
        "default": 0
      },
      "leave_notify": {
        "description": "退群通知",
        "hint": "当用户主动退群时，向群内通报",
        "type": "bool",
        "default": false
      },
      "leave_block": {
        "description": "退群拉黑",
        "hint": "当用户主动退群时，自动拉黑（即添加到进群黑名单）",
        "type": "bool",
        "default": false
      },
      "builtin_ban": {
        "description": "全局禁词",
        "hint": "全局禁词在网页面板中维护，保存在插件数据目录，不会修改插件内置词库。可通过命令“全局禁词 开/关”控制当前群是否启用",
        "type": "bool",
        "default": false
      },
      "custom_ban_words": {
        "description": "自定义禁词",
        "hint": "",
        "type": "list",
        "default": [
          "禁词1",
          "禁词2"
        ]
      },
      "word_ban_time": {
        "description": "禁词禁言时长",
        "hint": "触发违禁词则禁言发送者，单位：秒，设置为 0 表示不禁言",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 600,
          "step": 60
        },
        "default": 360
      },
      "spamming_ban_time": {
        "description": "刷屏禁言",
        "hint": "当用户刷屏时触发禁言该用户，设置为 0 表示不启用此功能",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 600,
          "step": 60
        },
        "default": 0
      },
      "clear_inactive_days": {
        "description": "清理未发言天数",
        "hint": "清理群友命令未指定天数时使用的默认值：超过此天数无发言且等级低于阈值的成员列入清理候选",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 365,
          "step": 1
        },
        "default": 30
      },
      "clear_under_level": {
        "description": "清理等级阈值",
        "hint": "清理群友命令未指定等级时使用的默认值：群等级低于此值的成员列入清理候选",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "default": 10
      },
      "clear_skip_allow": {
        "description": "清理跳过白名单",
        "hint": "开启后，清理群友时跳过白名单成员；关闭则白名单成员同样列入清理候选",
        "type": "bool",
        "default": true
      }
    }
  },
  "admin_audit": {
    "description": "仅通知管理员",
    "hint": "如果开启，则进群事件仅通知bot管理员，不再将通知发送在对应群聊",
    "type": "bool",
    "default": false
  },
  "random_ban_time": {
    "description": "随机禁言",
    "hint": "若禁言命令未指定禁言时长，则使用随机时长，时长范围如下，单位为秒，用~表示范围",
    "type": "string",
    "default": "30~300"
  },
  "vote_ban": {
    "description": "投票配置",
    "hint": "用于投票禁言/投票踢人（共用同一套时长与票数阈值，一群同时只能有一场投票）",
    "type": "object",
    "items": {
      "ttl": {
        "description": "投票时长（秒）",
        "hint": "每轮投票时长到达此值时开始结算，赞同票多于反对票时处罚（禁言/踢出）生效",
        "type": "int",
        "slider": {
          "min": 60,
          "max": 300,
          "step": 60
        },
        "default": 120
      },
      "threshold": {
        "description": "投票通过所需票数",
        "hint": "赞同票数到达此值时处罚直接生效",
        "type": "int",
        "slider": {
          "min": 2,
          "max": 10,
          "step": 1
        },
        "default": 3
      }
    }
  },
  "llm_get_msg_count": {
    "description": "取名消息轮数",
    "hint": "取名指令会爬取群聊的聊天记录进行分析，每轮爬200条消息，默认爬轮数10轮， 轮数可调",
    "type": "int",
    "slider": {
      "min": 1,
      "max": 40,
      "step": 1
    },
    "default": 10
  },
